# ============================================================
# FIREBASE ADMIN SDK — Cloud Firestore
# ============================================================
# Gere a chave privada em:
# Firebase Console -> Configurações do projeto -> Contas de serviço -> Gerar nova chave privada
#
# Desenvolvimento local (arquivo JSON — NUNCA suba para o Git!):
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Produção na Vercel (use as 3 variáveis abaixo OU FIREBASE_SERVICE_ACCOUNT_JSON):
FIREBASE_PROJECT_ID=painel-monet
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@painel-monet.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA_PELA_CHAVE_PRIVADA\n-----END PRIVATE KEY-----\n"
# Alternativa na Vercel (JSON completo em uma linha ou codificado em Base64):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================================
# AUTENTICAÇÃO JWT (obrigatória na Vercel)
# ============================================================
# Gere uma chave forte com:
# node -e "const c=require('crypto');process.stdout.write(c.randomBytes(48).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_FORTE_DE_96_CARACTERES_HEX
JWT_EXPIRES_IN=7d

# ============================================================
# SERVIDOR / CORS (FRONTEND_URL obrigatória na Vercel)
# ============================================================
# Aceita múltiplas origens separadas por vírgula (sem barra no final):
# Ex: https://seu-front.vercel.app,http://localhost:3001
FRONTEND_URL=http://localhost:3001
HOST=127.0.0.1
PORT=3000
