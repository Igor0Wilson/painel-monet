# ============================================================
# AMBIENTE FIREBASE ("production" = painel-monet | "development" = painel-monet-dev)
# ============================================================
FIREBASE_ENV=production

# ============================================================
# FIREBASE ADMIN SDK PRODUÇÃO — Cloud Firestore + Firebase Auth
# ============================================================
# Gere a chave privada em:
# Firebase Console -> Configurações do projeto -> Contas de serviço -> Gerar nova chave privada
#
# Desenvolvimento local (arquivo JSON — NUNCA suba para o Git!):
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Produção na Vercel (use as 3 variáveis abaixo OU FIREBASE_SERVICE_ACCOUNT_JSON):
FIREBASE_PROJECT_ID=painel-monet
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@painel-monet.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA_PELA_CHAVE_PRIVADA\n-----END PRIVATE KEY-----\n"
# Alternativa na Vercel (JSON completo em uma linha ou codificado em Base64):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Chave Web pública do Firebase PRODUÇÃO (obrigatória para disparo gratuito de e-mail
# de redefinição de senha / reativação de conta pelo Firebase Auth):
FIREBASE_WEB_API_KEY=AIzaSyA90BVLzITkG-Ez7mRTGVNz95LO0WEJHm4

# ============================================================
# FIREBASE ADMIN SDK DESENVOLVIMENTO / TESTES (painel-monet-dev)
# Usado automaticamente quando FIREBASE_ENV=development
# ============================================================
# Baixe o JSON de Service Account do projeto "painel-monet-dev" no Firebase Console e salve como:
FIREBASE_DEV_SERVICE_ACCOUNT_PATH=./firebase-service-account.dev.json
FIREBASE_DEV_PROJECT_ID=painel-monet-dev
# Ou informe via variáveis (Vercel Preview / Dev):
# FIREBASE_DEV_CLIENT_EMAIL=firebase-adminsdk-xxxxx@painel-monet-dev.iam.gserviceaccount.com
# FIREBASE_DEV_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_DEV_SERVICE_ACCOUNT_JSON=
FIREBASE_DEV_WEB_API_KEY=AIzaSyCp7epNvGqDH5TGCVEAW8_-3D-U_mV70u0
# Opcional: separe também a chave AES-256 e HMAC do ambiente DEV:
# DATA_ENCRYPTION_KEY_DEV=SUBSTITUA_POR_64_CARACTERES_HEX_EXCLUSIVOS_DE_DEV
# BLIND_INDEX_KEY_DEV=SUBSTITUA_POR_64_CARACTERES_HEX_HMAC_DE_DEV

# ============================================================
# CRIPTOGRAFIA AES-256-GCM EM NÍVEL DE APLICAÇÃO (OBRIGATÓRIA)
# ============================================================
# Chave própria de 256 bits (32 bytes em hex = 64 caracteres, ou Base64 32 bytes).
# NUNCA use KMS externo, NUNCA versionar no Git e NUNCA reutilize a mesma chave entre
# desenvolvimento, homologação e produção.
# Gere no terminal do responsável com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=SUBSTITUA_POR_64_CARACTERES_HEX_ALEATORIOS_256_BITS
DATA_ENCRYPTION_KEY_VERSION=k1
# Para rotação segura de chaves sem indisponibilidade (opcional):
# DATA_ENCRYPTION_KEY_PREVIOUS=k0:CHAVE_ANTERIOR_64_HEX
# Chave HMAC dedicada para índices cegos (opcional; caso omitida deriva via HKDF-SHA256 da DATA_ENCRYPTION_KEY):
# BLIND_INDEX_KEY=SUBSTITUA_POR_64_CARACTERES_HEX_PARA_BLIND_INDEX

# ============================================================
# AUTENTICAÇÃO JWT (obrigatória na Vercel — mínimo 32 caracteres)
# ============================================================
# Gere uma chave forte com:
# node -e "const c=require('crypto');process.stdout.write(c.randomBytes(48).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_FORTE_DE_96_CARACTERES_HEX
JWT_EXPIRES_IN=7d

# ============================================================
# SERVIDOR / CORS (FRONTEND_URL obrigatória na Vercel)
# ============================================================
# Aceita múltiplas origens separadas por vírgula (sem barra no final):
# Ex: https://painel-monet-front.vercel.app,http://localhost:3001
FRONTEND_URL=http://localhost:3001
HOST=127.0.0.1
PORT=3000

# ============================================================
# E-MAIL HTML PERSONALIZADO COM BOTÃO (Brevo grátis: 300/dia)
# ============================================================
# Opcional — se não configurar, usa automaticamente o e-mail padrão do Firebase.
# Crie conta gratuita em https://www.brevo.com -> SMTP & API -> API Keys:
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM_EMAIL=seu-email-verificado@gmail.com
# MAIL_FROM_NAME=Painel Monet
#
# Alternativa (Resend — 3.000/mês grátis com domínio próprio):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="Painel Monet <contato@seudominio.com.br>"

# ============================================================
# CLOUDINARY (Armazenamento de fotos de perfil e despesas)
# Configure também manualmente na Vercel (Backend) — NUNCA suba segredos para o Git
# ============================================================
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret
